# ── Supabase (PostgreSQL + pgvector) ────────────────────────────────────
# Use the Pooler URL (port 6543), not the direct DB URL (5432).
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-password@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-key

# ── Qdrant Cloud (vector store for RAG + CAG) ──────────────────────────
QDRANT_URL=https://your-instance-id.us-west-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# ── LLM Providers ───────────────────────────────────────────────────────
# OpenRouter is the default unified gateway; Groq is used for the fast
# guardrail/extractor LLM; OpenAI is used for embeddings.
OPENROUTER_API_KEY=your-openrouter-api-key
GROQ_API_KEY=your-groq-api-key
OPENAI_API_KEY=your-openai-api-key

# ── Azure Blob Storage ──────────────────────────────────────────────────
# Store Transcripts in Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=your-azure-storage-connection-string
AZURE_CONTAINER_NAME=transcripts
CAG_MIN_FREQUENCY=5

# ── LangFuse Observability ────────────────────────────────────────────
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# ── Neo4j Aura (graph database for RAG + CAG) ─────────────────────────────
NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USERNAME=your-instance-id
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=your-instance-id
AURA_INSTANCEID=your-instance-id
AURA_INSTANCENAME=Instance01

